---
import { url } from '../lib/url';
const nav = [
  { label: 'About', href: '/about/' },
  { label: 'Programs', href: '/programs/' },
  { label: 'Wellness', href: '/wellness/' },
  { label: 'Family', href: '/family/' },
  { label: 'Resources', href: '/resources/' },
];
const phone = '(760) 762-3605';
const tel = 'tel:+17607623605';
---
<header class="site-header">
  <div class="container bar">
    <a href={url('/')} class="brand" aria-label="New Beginnings Recovery — home">
      <img class="logo logo-day" src={url('/images/logo-primary.svg')} alt="New Beginnings Recovery" width="180" height="49" />
      <img class="logo logo-night" src={url('/images/logo-primary-light.svg')} alt="New Beginnings Recovery" width="180" height="49" />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav-list">
        <span class="visually-hidden">Menu</span>
        <span class="burger" aria-hidden="true"></span>
      </button>
      <ul id="nav-list">
        {nav.map((n) => (<li><a href={url(n.href)}>{n.label}</a></li>))}
      </ul>
    </nav>

    <div class="header-cta">
      <details class="display-menu">
        <summary aria-label="Display settings" title="Display settings">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg>
        </summary>
        <div class="display-panel" role="group" aria-label="Display preferences">
          <p class="dp-label">Theme</p>
          <div class="seg" data-seg="theme">
            <button type="button" data-val="system">System</button>
            <button type="button" data-val="light">Day</button>
            <button type="button" data-val="dark">Night</button>
          </div>
          <p class="dp-label">Text size</p>
          <div class="seg" data-seg="text">
            <button type="button" data-val="normal">Normal</button>
            <button type="button" data-val="large">Large</button>
          </div>
        </div>
      </details>
      <a href={url('/contact/')} class="btn btn-outline contact-btn">Contact</a>
      <a href={tel} class="btn btn-cta" aria-label={`Call New Beginnings Recovery at ${phone}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 4h4l2 5-3 2a12 12 0 006 6l2-3 5 2v4a2 2 0 01-2 2A17 17 0 013 6a2 2 0 012-2z"/></svg>
        <span class="phone-txt">{phone}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: saturate(1.4) blur(8px); border-bottom: 1px solid var(--hair); }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 4.75rem; }
  .brand { display: inline-flex; align-items: center; text-decoration: none; }
  .logo { height: 44px; width: auto; }
  .primary-nav { margin-inline-start: auto; }
  .primary-nav ul { list-style: none; display: flex; gap: 1.5rem; margin: 0; padding: 0; }
  .primary-nav a { text-decoration: none; color: var(--text-soft); font-weight: 600; font-size: .95rem; padding: .35rem 0; border-bottom: 2px solid transparent; }
  .primary-nav a:hover { color: var(--accent-ink); border-bottom-color: var(--accent); }
  .header-cta { display: flex; align-items: center; gap: .6rem; }
  .nav-toggle { display: none; }

  /* Display settings popover */
  .display-menu { position: relative; }
  .display-menu summary { list-style: none; cursor: pointer; display: inline-grid; place-items: center; width: 2.6rem; height: 2.6rem; border: 1px solid var(--hair); border-radius: var(--r-sm); color: var(--text-soft); background: var(--surface); }
  .display-menu summary::-webkit-details-marker { display: none; }
  .display-menu[open] summary { border-color: var(--accent); color: var(--accent-ink); }
  .display-panel { position: absolute; right: 0; top: calc(100% + .5rem); background: var(--surface); border: 1px solid var(--hair); border-radius: var(--r-md); box-shadow: var(--shadow-md); padding: 1rem; width: 15rem; z-index: 50; }
  .dp-label { font-family: "Mulish", sans-serif; font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); margin: 0 0 .5rem; font-weight: 700; }
  .dp-label + .seg { margin-bottom: 1rem; }
  .seg { display: flex; gap: 4px; background: var(--surface-alt); border: 1px solid var(--hair); border-radius: var(--r-sm); padding: 3px; }
  .seg button { flex: 1; border: 0; background: transparent; color: var(--text-soft); font-family: "Mulish", sans-serif; font-weight: 600; font-size: .82rem; padding: .4rem; border-radius: 5px; cursor: pointer; }
  .seg button[aria-pressed="true"] { background: var(--surface); color: var(--accent-ink); box-shadow: var(--shadow-sm); }

  @media (max-width: 66rem) {
    .contact-btn { display: none; }
  }
  @media (max-width: 62rem) {
    .nav-toggle { display: inline-grid; place-items: center; width: 2.6rem; height: 2.6rem; border: 1px solid var(--hair); background: var(--surface); border-radius: var(--r-sm); }
    .burger, .burger::before, .burger::after { content: ""; display: block; width: 20px; height: 2px; background: var(--text); border-radius: 2px; position: relative; }
    .burger::before { position: absolute; top: -6px; } .burger::after { position: absolute; top: 6px; }
    .primary-nav { margin-inline-start: auto; order: 3; }
    #nav-list { position: absolute; left: 0; right: 0; top: 100%; background: var(--surface); border-bottom: 1px solid var(--hair); flex-direction: column; gap: 0; padding: .5rem 1.5rem 1rem; box-shadow: var(--shadow-md); display: none; }
    #nav-list[data-open] { display: flex; }
    .primary-nav li { border-top: 1px solid var(--hair); }
    .primary-nav li a { display: block; padding: .85rem 0; }
  }
  @media (max-width: 30rem) {
    .phone-txt { display: none; }
    .logo { height: 38px; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const list = document.getElementById('nav-list');
  toggle?.addEventListener('click', () => {
    const open = list?.hasAttribute('data-open');
    if (open) list?.removeAttribute('data-open'); else list?.setAttribute('data-open', '');
    toggle.setAttribute('aria-expanded', String(!open));
  });

  // Display preferences (theme + text size)
  const root = document.documentElement;
  const getTheme = () => (localStorage.getItem('nbr-theme') || 'system');
  const getText = () => (localStorage.getItem('nbr-textsize') || 'normal');
  function paintSeg() {
    document.querySelectorAll<HTMLButtonElement>('[data-seg="theme"] button').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.val === getTheme())));
    document.querySelectorAll<HTMLButtonElement>('[data-seg="text"] button').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.val === getText())));
  }
  function applyTheme(v: string) {
    if (v === 'light' || v === 'dark') root.setAttribute('data-theme', v);
    else root.removeAttribute('data-theme');
    try { localStorage.setItem('nbr-theme', v); } catch {}
  }
  function applyText(v: string) {
    root.classList.toggle('text-lg', v === 'large');
    try { localStorage.setItem('nbr-textsize', v); } catch {}
  }
  document.querySelectorAll<HTMLButtonElement>('[data-seg="theme"] button').forEach((b) =>
    b.addEventListener('click', () => { applyTheme(b.dataset.val!); paintSeg(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-seg="text"] button').forEach((b) =>
    b.addEventListener('click', () => { applyText(b.dataset.val!); paintSeg(); }));
  paintSeg();

  // Close the popover on outside click
  document.addEventListener('click', (e) => {
    const menu = document.querySelector('.display-menu');
    if (menu && menu.hasAttribute('open') && !menu.contains(e.target as Node)) menu.removeAttribute('open');
  });
</script>
