---
import { url } from '../lib/url';
interface Props { eyebrow?: string; title: string; lede?: string; image?: string; imageAlt?: string; }
const { eyebrow = 'New Beginnings Recovery', title, lede, image, imageAlt } = Astro.props;
const hasImage = Boolean(image);
---
<section class:list={["page-hero", { "has-image": hasImage }]}>
  <div class:list={["container", hasImage ? "hero-grid" : "stack"]}>
    <div class="hero-copy stack">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
    </div>
    {hasImage && (
      <div class="hero-art">
        <img src={url(image!)} alt={imageAlt ?? ''} width="1500" height="1000" loading="eager" />
      </div>
    )}
  </div>
</section>
<style>
  .page-hero { background:
    radial-gradient(90% 120% at 92% -20%, var(--gold-100) 0%, transparent 45%),
    linear-gradient(180deg, var(--surface-alt) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--hair); padding-block: clamp(2.75rem, 6vw, 4.25rem); overflow: clip; }
  .page-hero h1 { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.1rem); font-weight: 600; letter-spacing: -.015em; }
  .page-hero .lede { margin-top: .25rem; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 2.5rem; align-items: center; }
  .hero-art img { width: 100%; height: 100%; max-height: 24rem; object-fit: cover; border-radius: var(--r-lg); box-shadow: var(--shadow-md); }
  @media (max-width: 52rem) {
    .hero-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .hero-art img { max-height: 14rem; }
  }
</style>
