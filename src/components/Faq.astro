---
interface Props { items: { q: string; a: string }[]; title?: string; }
const { items, title = 'Frequently asked questions' } = Astro.props;
---
<section class="section faq">
  <div class="container">
    <h2 class="faq-title">{title}</h2>
    <div class="faq-list">
      {items.map((it) => (
        <details class="faq-item">
          <summary>{it.q}</summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq-title { font-size: clamp(1.6rem, 1.3rem + 1.4vw, 2.2rem); margin-bottom: 1.5rem; }
  .faq-list { max-width: 48rem; display: grid; gap: .6rem; }
  .faq-item { background: var(--surface); border: 1px solid var(--hair); border-radius: var(--r-md); padding: 0 1.25rem; }
  .faq-item summary { cursor: pointer; padding: 1.1rem 0; font-weight: 700; color: var(--text); list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; font-family: "Fraunces", serif; font-size: 1.5rem; color: var(--accent); line-height: 1; }
  .faq-item[open] summary::after { content: "–"; }
  .faq-item p { margin: 0 0 1.1rem; color: var(--text-soft); }
</style>
