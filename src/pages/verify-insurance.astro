---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SecureIntakeForm from '../components/SecureIntakeForm.astro';
import { site } from '../lib/site';

const insuranceFields = [
  { name: 'fullName', label: 'Your name', required: true, autocomplete: 'name' },
  { name: 'phone', label: 'Phone', type: 'tel', required: true, autocomplete: 'tel' },
  { name: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
  { name: 'insuranceProvider', label: 'Insurance provider' },
  { name: 'memberId', label: 'Member ID' },
  { name: 'bestTime', label: 'Best time to reach you' },
  { name: 'message', label: 'Anything you’d like us to know', type: 'textarea' },
];

const steps = [
  { t: 'Call or reach out', d: 'A quick, confidential conversation with our admissions team — no obligation.' },
  { t: 'We check your benefits', d: 'We contact your insurer directly to confirm what your plan covers for detox and residential treatment.' },
  { t: 'We explain your options', d: 'Clear information on coverage, any out-of-pocket costs, and flexible payment options if you’re self-pay.' },
];
---
<Base title="Verify Your Insurance — New Beginnings Recovery" description="Confidentially check whether your insurance covers detox and residential addiction treatment at New Beginnings Recovery. Most major plans accepted.">
  <PageHero eyebrow="Insurance" title="Find out if your insurance covers treatment" lede="A quick, confidential benefits check — no obligation. Most major insurance plans are accepted, and we never share your information." image="/images/photo-180.jpg" imageAlt="New Beginnings Recovery private facility in Rancho Mirage, California" />

  <section class="section">
    <div class="container prose" style="max-width:52rem">
      <h2>How verification works</h2>
      <ol class="steps">
        {steps.map((s, i) => (<li><span class="num tabular">{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>))}
      </ol>

      <h2 style="margin-top:2.5rem">What to have ready</h2>
      <ul>
        <li>The name of your insurance provider</li>
        <li>Your member ID (from your insurance card)</li>
        <li>A good phone number where we can reach you</li>
      </ul>

      <h2 style="margin-top:2.5rem">Start a confidential benefits check</h2>
      <SecureIntakeForm formType="insurance-verification" fields={insuranceFields} submitLabel="Check my benefits securely">
        <div slot="fallback">
          <div class="callout" style="margin-top:1.5rem">
            <p><strong>Your privacy comes first.</strong> Our secure online verification form is being finalized. For now — and for anything involving health or insurance details — please call us directly rather than sending them by email. We handle your information confidentially and never sell or share it for advertising.</p>
          </div>
          <p style="margin-top:2rem"><a href={site.phoneHref} class="btn btn-cta">Call {site.phone} to verify</a></p>
        </div>
      </SecureIntakeForm>
    </div>
  </section>

  <style>
    .steps { list-style: none; padding: 0; display: grid; gap: 1rem; margin-top: 1.25rem; }
    .steps li { display: grid; grid-template-columns: 2.75rem 1fr; gap: 1rem; align-items: start; }
    .steps .num { font-family: "Fraunces", serif; font-size: 1.1rem; font-weight: 600; color: var(--accent); border: 1px solid var(--hair-strong); border-radius: 50%; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; }
    .steps h3 { font-family: "Mulish", sans-serif; font-size: 1.05rem; font-weight: 700; margin-bottom: .1rem; }
    .steps p { color: var(--text-soft); margin: 0; }
  </style>
</Base>
