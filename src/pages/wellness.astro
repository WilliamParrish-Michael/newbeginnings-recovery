---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { url } from '../lib/url';

const services = [
  { t: 'Mindfulness', d: 'Practical skills to notice cravings and hard emotions — and let them pass.', href: '/wellness/mindfulness/', img: '/images/wellness/mindfulness.jpeg' },
  { t: 'Nutrition counseling', d: 'Rebuilding the body after substance use to steady mood, energy, and cravings.', href: '/wellness/nutrition-counseling/', img: '/images/wellness/nutrition-counseling.jpeg' },
  { t: 'Ayurveda', d: 'Ayurveda-inspired rhythm and calm to restore balance in early recovery.', href: '/wellness/ayurveda/', img: '/images/wellness/ayurveda.jpeg' },
];

const nutrition = [
  { t: 'Stability', d: 'Balanced meals regulate blood sugar, reducing mood swings and cravings.' },
  { t: 'Healing', d: 'Nutrients strengthen the liver, heart, and digestive system, repairing damage from substance use.' },
  { t: 'Resilience', d: 'Better sleep, stronger immunity, and restored energy help clients engage more deeply in therapy.' },
  { t: 'Hope', d: 'Small wins — improved appetite, energy, and mood — remind clients that change is possible.' },
];
const practices = ['Yoga-inspired movement to restore calm and connection with the body.', 'Meditation and mindfulness to reduce stress and cravings.', 'Breathwork and reflection to quiet the nervous system.', 'Lifestyle balance strategies that help rebuild everyday structure.'];
const faqs = [
  { q: 'What wellness services do you offer?', a: 'A range of optional, supplemental services — including mindfulness practice, yoga-inspired movement, nutritional counseling, Ayurveda, and stress-management support.' },
  { q: 'Are wellness services included in treatment programs?', a: 'Yes — wellness services are integrated into detox and residential treatment plans, complementing clinical care with physical and emotional support.' },
  { q: 'Do you offer personalized wellness plans?', a: 'Yes — our clinical and wellness teams collaborate to tailor wellness plans to each client’s needs, supporting physical, emotional, and mental health.' },
];
---
<Base title="Wellness Services in Rancho Mirage & Palm Springs — New Beginnings Recovery" description="Optional, supplemental wellness — nutrition counseling, Ayurveda-inspired practices, and mindfulness — that complement clinical addiction treatment in Rancho Mirage.">
  <PageHero eyebrow="Wellness Services" title="Whole-person healing in recovery" lede="Recovery isn’t only about breaking free from drugs or alcohol — it’s about learning to live fully again. Our wellness services are optional and supplemental, offered alongside medical and therapeutic care." image="/images/photo-176.jpg" imageAlt="A restful space at New Beginnings Recovery in Rancho Mirage" />

  <section class="section">
    <div class="container prose">
      <h2>Nutrition counseling: rebuilding from within</h2>
      <p>Substance use often leaves the body starved of what it needs most. With the guidance of a registered dietitian, clients can begin to restore what addiction has taken away.</p>
      <div class="feature-grid">
        {nutrition.map((n) => (<div class="feature"><h3>{n.t}</h3><p>{n.d}</p></div>))}
      </div>

      <h2>Ayurveda & mind-body practices</h2>
      <p>Our founder’s passion for Ayurveda and holistic healing shapes the spirit of New Beginnings. These services are not part of our licensed treatment program; clients who wish to explore them may do so as optional supports.</p>
      <ul>{practices.map((p) => (<li>{p}</li>))}</ul>
      <p>These practices don’t replace therapy or medicine — they enhance recovery by helping clients feel more centered, resilient, and whole.</p>

      <h2>The Rancho Mirage setting</h2>
      <p>Wellness is also about environment. The desert sun, mountain views, and private courtyards of our Rancho Mirage property create a natural sense of peace. The pool offers a place for renewal, while quiet spaces allow reflection and calm.</p>
    </div>
  </section>

  <section class="section" style="background: var(--surface-alt)">
    <div class="container">
      <div class="section-head stack"><span class="eyebrow">Explore each service</span><h2>Optional supports, tailored to you</h2></div>
      <div class="svc-grid">
        {services.map((s) => (
          <a class="svc card" href={url(s.href)}>
            <img src={url(s.img)} alt="" width="600" height="360" loading="lazy" />
            <div class="svc-body">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <span class="more">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Faq items={faqs} title="FAQs about wellness services" />

  <style>
    .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .svc { padding: 0; overflow: hidden; text-decoration: none; color: var(--text); display: flex; flex-direction: column; }
    .svc img { width: 100%; aspect-ratio: 5 / 3; object-fit: cover; }
    .svc-body { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; gap: .4rem; flex: 1; }
    .svc h3 { font-size: 1.2rem; color: var(--accent-ink); }
    .svc p { color: var(--text-soft); font-size: .93rem; flex: 1; }
    .svc .more { font-weight: 700; color: var(--accent); font-size: .88rem; }
    .svc:hover { box-shadow: var(--shadow-md); }
    @media (max-width: 56rem) { .svc-grid { grid-template-columns: 1fr; } }
  </style>
  <CtaBand title="Begin whole-person healing today" text="Every client receives safe, evidence-based care, with the option to explore services that strengthen body, mind, and spirit." />
</Base>
