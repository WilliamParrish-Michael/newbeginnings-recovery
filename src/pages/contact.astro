---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SecureIntakeForm from '../components/SecureIntakeForm.astro';
import { site } from '../lib/site';
import { url } from '../lib/url';

const contactFields = [
  { name: 'fullName', label: 'Your name', required: true, autocomplete: 'name' },
  { name: 'phone', label: 'Phone', type: 'tel', required: true, autocomplete: 'tel' },
  { name: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
  { name: 'message', label: 'How can we help?', type: 'textarea', required: true },
];
---
<Base title="Contact Us — New Beginnings Recovery" description="Reach New Beginnings Recovery in Rancho Mirage, California. Confidential admissions available 24/7 by phone.">
  <PageHero eyebrow="Contact Us" title="Reach out — confidentially, any time" lede="Whether you’re calling for yourself or someone you love, our admissions team is here to listen. Most conversations start with a simple, private phone call." image="/images/photo-169.jpg" imageAlt="New Beginnings Recovery in Rancho Mirage, California" />

  <section class="section">
    <div class="container contact-grid">
      <div class="stack">
        <div class="contact-card card">
          <span class="k">Call (24/7)</span>
          <a class="big" href={site.phoneHref}>{site.phone}</a>
        </div>
        <div class="contact-card card">
          <span class="k">Email</span>
          <a class="big" href={`mailto:${site.email}`}>{site.email}</a>
          <p class="note">Please don’t include sensitive health details in email — call us for anything confidential.</p>
        </div>
        <div class="contact-card card">
          <span class="k">Visit</span>
          <address>{site.addressLine}</address>
          <p class="note">Serving {site.serviceArea}.</p>
        </div>
      </div>
      <div class="prose">
        <h2>What happens when you call</h2>
        <p>Your first call is private and pressure-free. Our team listens, answers your questions, and helps determine whether New Beginnings is the right fit — then walks you through insurance and next steps.</p>
        <p>Prefer to start with insurance? We can run a quick, confidential benefits check. <a href={url('/verify-insurance/')}>Verify your insurance →</a></p>
        <h2 style="margin-top:1.75rem">Send a secure message</h2>
        <SecureIntakeForm formType="contact" fields={contactFields} submitLabel="Send securely">
          <div slot="fallback">
            <div class="callout"><p>Our secure online intake form is being finalized. Until then, the fastest and most private way to reach us is by phone — please don’t send health details by email.</p></div>
          </div>
        </SecureIntakeForm>
        <p style="margin-top:1.5rem"><strong>In crisis?</strong> If you or someone you know is in immediate danger, call 911. For mental-health crisis support, call or text <a href="tel:988">988</a>, the Suicide &amp; Crisis Lifeline.</p>
      </div>
    </div>
  </section>

  <style>
    .contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 2.5rem; align-items: start; }
    .contact-card .k { font-family: "Mulish", sans-serif; font-weight: 700; font-size: .74rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
    .contact-card .big { display: block; font-family: "Fraunces", serif; font-size: 1.5rem; color: var(--accent-ink); text-decoration: none; margin-top: .3rem; }
    .contact-card address { font-style: normal; font-size: 1.1rem; margin-top: .3rem; }
    .contact-card .note { color: var(--text-muted); font-size: .85rem; margin-top: .5rem; }
    @media (max-width: 52rem) { .contact-grid { grid-template-columns: 1fr; gap: 1.5rem; } }
  </style>
</Base>
